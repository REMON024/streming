{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    "Issuer": "streaming-platform",
    "Audience": "streaming-platform-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UseSSL": false,
    "BucketVideosRaw": "videos-raw",
    "BucketVideosHls": "videos-hls",
    "BucketThumbnails": "thumbnails",
    "BucketSubtitles": "subtitles"
  },
  "Redis": {
    "CacheTtlMinutes": 10
  },
  "StreamingService": {
    "BaseUrl": "http://localhost:8080"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=streaming_platform;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "AllowedHosts": "*"
}
