{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    "Issuer": "streaming-platform",
    "Audience": "streaming-platform-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UseSSL": false,
    "BucketVideosRaw": "videos-raw",
    "BucketVideosHls": "videos-hls",
    "BucketThumbnails": "thumbnails",
    "BucketSubtitles": "subtitles"
  },
  "Redis": {
    "CacheTtlMinutes": 10
  },
  "StreamingService": {
    "BaseUrl": "http://localhost:8080"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=streaming_platform;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "AllowedHosts": "*",
  "Ads": {
    "Enabled": true,
    "MidRollIntervalMinutes": 15,
    "PreRoll": {
      "VideoUrl": "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4",
      "ClickThroughUrl": "https://streamix.example.com/upgrade",
      "AdvertiserName": "Streamix Premium",
      "SkipAfterSeconds": 5
    },
    "MidRoll": {
      "ImageUrl": "https://via.placeholder.com/120x80/E50914/ffffff?text=Streamix",
      "ClickThroughUrl": "https://streamix.example.com/upgrade",
      "AdvertiserName": "Streamix",
      "Headline": "Enjoy ad-free streaming — upgrade to Premium",
      "DurationSeconds": 30,
      "CloseAfterSeconds": 5
    }
  }
}
